# single public entrypoint... everything under /api goes to the api services
# everything else goes to web... neither service publishes a port of its own

# Substituted at container start by the nginx image's entrypoint, which runs
# envsubst over /etc/nginx/templates/*.template.
#
# Parameterised because the same image has to work in two topologies. Under
# compose the services are `api:5000` and `web:5000`. In Azure Container Apps
# they are internal FQDNs on port 80 -- ACA's ingress listens on 80 and maps to
# the container's target port, so the 5000 is not visible to callers.
#
# Only variables that exist in the environment are substituted, so nginx's own
# $host, $scheme and $proxy_add_x_forwarded_for are left alone.
server {
    listen 80;

    # Resolve upstreams per request instead of once at startup.
    #
    # An `upstream { server api:5000; }` block is resolved when nginx starts,
    # and nginx refuses to start at all if the name does not resolve yet. Under
    # compose that is safe because depends_on orders startup. Azure Container
    # Apps gives no such guarantee, so a gateway that happened to start first
    # would crash-loop until something restarted it.
    #
    # NGINX_LOCAL_RESOLVERS is set by the image's own entrypoint from
    # /etc/resolv.conf, so this works in any runtime without hardcoding a DNS
    # server address.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    server_name _;

    # must match the api MAX_UPLOAD_MB... nginx defaults to 1 MB rejects 
    # anything bigger with a 413 before the request reaches the app
    # so a cover image upload would fail with an nginx error page while the api's
    # own 10 MB limit never got a say
    client_max_body_size 10m;

    # compress text on the way out... images and fonts are already compressed
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        # $request_uri is required: with a variable in proxy_pass, nginx no
        # longer appends the original URI automatically, and /api/preschools
        # would arrive as /.
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass http://$api_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location / {
        set $web_upstream "${WEB_UPSTREAM}";
        proxy_pass http://$web_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }
}