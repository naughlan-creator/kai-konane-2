# Copy to .env and fill in. .env is git-ignored -- never commit real values.
# A real environment variable always overrides what is in this file.

# development | production
# In production, DATABASE_URL and SECRET_KEY are required and the app refuses
# to start without them.
APP_ENV=development

# Leave unset in development to use a local SQLite file at instance/kai_konane.db.
# DATABASE_URL=postgresql://user:password@host:5432/kai_konane

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset in development a random key is generated per run (you get logged out
# on every restart).
SECRET_KEY=

# Used only by `flask create-admin` and `flask seed`.
# Leave ADMIN_PASSWORD blank and the command generates a strong one and prints
# it once.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Password given to the demo teacher/parent/child accounts created by
# `flask seed --demo`. Blank means one is generated and printed.
DEMO_PASSWORD=

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=10
