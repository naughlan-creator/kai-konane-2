# Local database (created by `flask init-db`)
instance/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# Environment / secrets -- never commit real credentials
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Coverage artefacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# infrastructure
.terraform/
*.tfstate
*.tfstate.*
crash.log
# State and tfvars hold credentials in plaintext. The lock file does not, and
# is deliberately NOT ignored -- it pins exact provider versions and hashes,
# which is what makes someone else's init reproduce this one.
*.tfvars
!*.tfvars.example
